{
  "git-auto-stage": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require('./scripts/auto-stage.js')}catch{require('./.agents/scripts/auto-stage.js')}\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "design-system-check": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const {spawnSync}=require('child_process'),fs=require('fs');const p=['./scripts/design-system-check.mjs','./.agents/scripts/design-system-check.mjs','../.agents/scripts/design-system-check.mjs','./.claude/hooks/design-system-check.mjs','../.claude/hooks/design-system-check.mjs'].find(fs.existsSync);process.exit(spawnSync(process.execPath,[p],{stdio:'inherit'}).status)\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node -e \"const {spawnSync}=require('child_process'),fs=require('fs');const p=['./scripts/design-system-check.mjs','./.agents/scripts/design-system-check.mjs','../.agents/scripts/design-system-check.mjs','./.claude/hooks/design-system-check.mjs','../.claude/hooks/design-system-check.mjs'].find(fs.existsSync);process.exit(spawnSync(process.execPath,[p],{stdio:'inherit'}).status)\"",
        "timeout": 30
      }
    ]
  }
}
