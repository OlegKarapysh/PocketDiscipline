{
  "git-auto-stage": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require('./scripts/auto-stage.js')}catch{require('./.agents/scripts/auto-stage.js')}\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "design-system-check": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require('./scripts/design-system-hook.cjs')}catch{require('./.agents/scripts/design-system-hook.cjs')}\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node -e \"try{require('./scripts/design-system-hook.cjs')}catch{require('./.agents/scripts/design-system-hook.cjs')}\"",
        "timeout": 30
      }
    ]
  }
}
